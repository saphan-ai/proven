{
  "version": 1,
  "input": "change",
  "note": "Proven's change registry (ADR-0049 point 1): the six kinds of change a review plan is chosen for. Each file of a change counts for the kind whose heaviest pattern it matches. Security patterns weigh most, so a sensitive file is never counted as anything else; the review also adds the security patterns of its own configured path rules (ADR-0014). Bands are tightened for this surface: only a change that is wholly one kind is in the High band.",
  "bands": { "high": 1.0, "medium": 0.8, "low": 0.0 },
  "intents": [
    {
      "id": "GENERAL",
      "category": "general",
      "description": "No kind fits: no changed file matches any pattern. The review runs the class its configured rules choose.",
      "capabilities": [],
      "riskClass": "low",
      "surfaces": ["change"],
      "roles": ["*"],
      "examples": ["M assets/logo.png"],
      "version": 1
    },
    {
      "id": "change.security",
      "category": "change",
      "description": "Security-sensitive code: authentication, sessions, tokens, secrets, permissions, cryptography, payments or schema migrations.",
      "capabilities": ["plan.security"],
      "riskClass": "high",
      "surfaces": ["change"],
      "roles": ["*"],
      "examples": ["M internal/auth/session.go", "M migrations/0007_add_index.sql"],
      "version": 1,
      "triggers": [
        { "path": "**/auth/**", "weight": 5 },
        { "path": "**/payment*/**", "weight": 5 },
        { "path": "**/*secret*", "weight": 5 },
        { "path": "**/migrations/**", "weight": 5 },
        { "path": "**/security/**", "weight": 5 },
        { "path": "**/login/**", "weight": 5 },
        { "path": "**/session/**", "weight": 5 },
        { "path": "**/crypto/**", "weight": 5 },
        { "path": "**/auth.*", "weight": 5 },
        { "path": "**/auth_*", "weight": 5 },
        { "path": "**/*_auth.*", "weight": 5 },
        { "path": "**/*oauth*", "weight": 5 },
        { "path": "**/*jwt*", "weight": 5 },
        { "path": "**/*password*", "weight": 5 },
        { "path": "**/*login*", "weight": 5 },
        { "path": "**/*session*", "weight": 5 },
        { "path": "**/*token*", "weight": 5 },
        { "path": "**/*crypt*", "weight": 5 },
        { "path": "**/*permission*", "weight": 5 },
        { "path": "**/*sandbox*", "weight": 5 },
        { "path": "**/*.pem", "weight": 5 },
        { "path": "**/*.key", "weight": 5 }
      ]
    },
    {
      "id": "change.dependency",
      "category": "change",
      "description": "A dependency change: module files, lockfiles, package manifests or vendored code, and nothing else.",
      "capabilities": ["plan.dependency"],
      "riskClass": "medium",
      "surfaces": ["change"],
      "roles": ["*"],
      "examples": ["M go.mod\nM go.sum"],
      "version": 1,
      "triggers": [
        { "path": "go.mod", "weight": 4 },
        { "path": "go.sum", "weight": 4 },
        { "path": "package.json", "weight": 4 },
        { "path": "package-lock.json", "weight": 4 },
        { "path": "pnpm-lock.yaml", "weight": 4 },
        { "path": "yarn.lock", "weight": 4 },
        { "path": "Cargo.toml", "weight": 4 },
        { "path": "Cargo.lock", "weight": 4 },
        { "path": "requirements.txt", "weight": 4 },
        { "path": "Pipfile", "weight": 4 },
        { "path": "Pipfile.lock", "weight": 4 },
        { "path": "poetry.lock", "weight": 4 },
        { "path": "Gemfile", "weight": 4 },
        { "path": "Gemfile.lock", "weight": 4 },
        { "path": "composer.json", "weight": 4 },
        { "path": "composer.lock", "weight": 4 },
        { "path": "pom.xml", "weight": 4 },
        { "path": "build.gradle", "weight": 4 },
        { "path": "build.gradle.kts", "weight": 4 },
        { "path": "**/vendor/**", "weight": 4 }
      ]
    },
    {
      "id": "change.docs",
      "category": "change",
      "description": "Documentation only: Markdown and other prose files, the docs directory, licences.",
      "capabilities": ["plan.docs"],
      "riskClass": "low",
      "surfaces": ["change"],
      "roles": ["*"],
      "examples": ["M README.md\nM docs/INSTALL.md"],
      "version": 1,
      "triggers": [
        { "path": "**/*.md", "weight": 3 },
        { "path": "docs/**", "weight": 3 },
        { "path": "**/*.rst", "weight": 3 },
        { "path": "**/*.adoc", "weight": 3 },
        { "path": "LICENSE*", "weight": 3 },
        { "path": "**/*.txt", "weight": 2 }
      ]
    },
    {
      "id": "change.config",
      "category": "change",
      "description": "Configuration: YAML, TOML and INI settings, CI workflows, container and build files.",
      "capabilities": ["plan.config"],
      "riskClass": "medium",
      "surfaces": ["change"],
      "roles": ["*"],
      "examples": ["M .github/workflows/ci.yml\nM proven.yaml"],
      "version": 1,
      "triggers": [
        { "path": "**/*.yaml", "weight": 2 },
        { "path": "**/*.yml", "weight": 2 },
        { "path": "**/*.toml", "weight": 2 },
        { "path": "**/*.ini", "weight": 2 },
        { "path": "**/*.cfg", "weight": 2 },
        { "path": "**/*.conf", "weight": 2 },
        { "path": ".github/**", "weight": 2 },
        { "path": "Dockerfile", "weight": 2 },
        { "path": "**/*.dockerfile", "weight": 2 },
        { "path": "Makefile", "weight": 2 },
        { "path": ".gitignore", "weight": 2 },
        { "path": ".editorconfig", "weight": 2 },
        { "path": "**/*.json", "weight": 1 }
      ]
    },
    {
      "id": "change.feature",
      "category": "change",
      "description": "A feature: source files added or modified.",
      "capabilities": ["plan.feature"],
      "riskClass": "medium",
      "surfaces": ["change"],
      "roles": ["*"],
      "examples": ["A internal/scout/scout.go\nM cmd/proven/main.go"],
      "version": 1,
      "triggers": [
        { "path": "**/*.go", "status": "A", "weight": 2 },
        { "path": "**/*.ts", "status": "A", "weight": 2 },
        { "path": "**/*.tsx", "status": "A", "weight": 2 },
        { "path": "**/*.js", "status": "A", "weight": 2 },
        { "path": "**/*.py", "status": "A", "weight": 2 },
        { "path": "**/*.rs", "status": "A", "weight": 2 },
        { "path": "**/*.java", "status": "A", "weight": 2 },
        { "path": "**/*.kt", "status": "A", "weight": 2 },
        { "path": "**/*.rb", "status": "A", "weight": 2 },
        { "path": "**/*.php", "status": "A", "weight": 2 },
        { "path": "**/*.c", "status": "A", "weight": 2 },
        { "path": "**/*.h", "status": "A", "weight": 2 },
        { "path": "**/*.cpp", "status": "A", "weight": 2 },
        { "path": "**/*.cs", "status": "A", "weight": 2 },
        { "path": "**/*.swift", "status": "A", "weight": 2 },
        { "path": "**/*.sh", "status": "A", "weight": 2 },
        { "path": "**/*.sql", "status": "A", "weight": 2 },
        { "path": "**/*.go", "status": "M", "weight": 1 },
        { "path": "**/*.ts", "status": "M", "weight": 1 },
        { "path": "**/*.tsx", "status": "M", "weight": 1 },
        { "path": "**/*.js", "status": "M", "weight": 1 },
        { "path": "**/*.py", "status": "M", "weight": 1 },
        { "path": "**/*.rs", "status": "M", "weight": 1 },
        { "path": "**/*.java", "status": "M", "weight": 1 },
        { "path": "**/*.kt", "status": "M", "weight": 1 },
        { "path": "**/*.rb", "status": "M", "weight": 1 },
        { "path": "**/*.php", "status": "M", "weight": 1 },
        { "path": "**/*.c", "status": "M", "weight": 1 },
        { "path": "**/*.h", "status": "M", "weight": 1 },
        { "path": "**/*.cpp", "status": "M", "weight": 1 },
        { "path": "**/*.cs", "status": "M", "weight": 1 },
        { "path": "**/*.swift", "status": "M", "weight": 1 },
        { "path": "**/*.sh", "status": "M", "weight": 1 },
        { "path": "**/*.sql", "status": "M", "weight": 1 }
      ]
    },
    {
      "id": "change.refactor",
      "category": "change",
      "description": "A refactor: source files renamed, moved or deleted.",
      "capabilities": ["plan.refactor"],
      "riskClass": "medium",
      "surfaces": ["change"],
      "roles": ["*"],
      "examples": ["R internal/a/old.go -> internal/b/new.go\nD internal/a/unused.go"],
      "version": 1,
      "triggers": [
        { "path": "**/*.go", "status": "RD", "weight": 2 },
        { "path": "**/*.ts", "status": "RD", "weight": 2 },
        { "path": "**/*.tsx", "status": "RD", "weight": 2 },
        { "path": "**/*.js", "status": "RD", "weight": 2 },
        { "path": "**/*.py", "status": "RD", "weight": 2 },
        { "path": "**/*.rs", "status": "RD", "weight": 2 },
        { "path": "**/*.java", "status": "RD", "weight": 2 },
        { "path": "**/*.kt", "status": "RD", "weight": 2 },
        { "path": "**/*.rb", "status": "RD", "weight": 2 },
        { "path": "**/*.php", "status": "RD", "weight": 2 },
        { "path": "**/*.c", "status": "RD", "weight": 2 },
        { "path": "**/*.h", "status": "RD", "weight": 2 },
        { "path": "**/*.cpp", "status": "RD", "weight": 2 },
        { "path": "**/*.cs", "status": "RD", "weight": 2 },
        { "path": "**/*.swift", "status": "RD", "weight": 2 },
        { "path": "**/*.sh", "status": "RD", "weight": 2 },
        { "path": "**/*.sql", "status": "RD", "weight": 2 }
      ]
    }
  ]
}
