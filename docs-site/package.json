{
  "name": "proven-docs-site",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "guards": "node scripts/guards.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build": "npm run content && npm run guards && next build",
    "dev": "npm run content && next dev",
    "start": "node .next/standalone/server.js",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "15.3.0",
    "fumadocs-mdx": "11.6.0",
    "fumadocs-ui": "15.3.0",
    "next": "15.3.0",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.7",
    "@types/mdx": "2.0.13",
    "@types/node": "22.15.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "tailwindcss": "4.1.7",
    "typescript": "5.8.3"
  }
}
