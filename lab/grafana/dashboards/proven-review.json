{
  "uid": "proven-review",
  "title": "Proven: a review as it happens",
  "description": "The agents and the two reviewer models of a Proven review, the verdicts side by side, what was dropped, and how long the models took. Provisioned from lab/grafana/dashboards; ADR-0045.",
  "tags": ["proven"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": { "refresh_intervals": ["2s", "5s", "10s", "30s", "1m"] },
  "templating": {
    "list": [
      { "name": "ds_prom", "type": "datasource", "query": "prometheus", "hide": 2, "current": {} },
      { "name": "ds_tempo", "type": "datasource", "query": "tempo", "hide": 2, "current": {} },
      {
        "name": "run",
        "label": "Review",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
        "query": { "query": "label_values(proven_agent_state, instance)", "refId": "run" },
        "definition": "label_values(proven_agent_state, instance)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "The agents and the two reviewers",
      "description": "One row per agent. The planner and the skeptic have one row per reviewer model: default and special. Waiting, working, done, failed. A reviewer that has its verdict while the other still works shows as done beside working.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "proven_agent_state{instance=~\"$run\"}",
          "legendFormat": "{{proven_agent}} · {{proven_reviewer}}",
          "interval": "1s",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 85, "lineWidth": 0 },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#8a8f98", "value": null }] },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "index": 0, "text": "waiting", "color": "#8a8f98" },
                "1": { "index": 1, "text": "working", "color": "#3274d9" },
                "2": { "index": 2, "text": "done", "color": "#37872d" },
                "3": { "index": 3, "text": "failed", "color": "#c4162a" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Verdicts, side by side",
      "description": "What each reviewer's skeptic said of each finding: refuted, upheld, or not attempted. One column per reviewer model.",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proven_reviewer, verdict) (last_over_time(proven_reviewer_verdicts_total{instance=~\"$run\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": { "columnField": "proven_reviewer", "rowField": "verdict", "valueField": "Value", "emptyValue": "zero" }
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "md" }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Where the reviewers disagree",
      "description": "Findings on which the two reviewers differ: verdict (both ran it, they judged it differently) or one_reviewer (only one of them named it).",
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (last_over_time(proven_reviewer_disagreements_total{instance=~\"$run\"}[$__range])) or on() label_replace(vector(0), \"kind\", \"none\", \"\", \"\")",
          "legendFormat": "{{kind}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#ff9830" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#ff9830", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Claims dropped",
      "description": "Claims the Judge did not keep, by reason: no evidence, refuted by the skeptic, or suppressed by an earlier refutation.",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (last_over_time(proven_review_claims_dropped_total{instance=~\"$run\"}[$__range])) or on() label_replace(vector(0), \"reason\", \"none\", \"\", \"\")",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#c4162a" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#c4162a", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Findings by level of proof",
      "description": "What the review kept, by how far a reader may trust it (ADR-0044).",
      "gridPos": { "x": 0, "y": 17, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proven_proof_level) (last_over_time(proven_review_findings_total{instance=~\"$run\"}[$__range]))",
          "legendFormat": "{{proven_proof_level}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#37872d" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#37872d", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Model latency (mean per call)",
      "description": "How long a call to a model took, by agent and reviewer (gen_ai.client.operation.duration).",
      "gridPos": { "x": 8, "y": 17, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proven_agent, proven_reviewer) (last_over_time(gen_ai_client_operation_duration_seconds_sum{instance=~\"$run\"}[$__range])) / sum by (proven_agent, proven_reviewer) (last_over_time(gen_ai_client_operation_duration_seconds_count{instance=~\"$run\"}[$__range]))",
          "legendFormat": "{{proven_agent}} · {{proven_reviewer}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#37872d", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Model calls",
      "description": "Calls made to a model, by reviewer and outcome.",
      "gridPos": { "x": 16, "y": 17, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proven_reviewer, outcome) (last_over_time(proven_model_calls_total{instance=~\"$run\"}[$__range]))",
          "legendFormat": "{{proven_reviewer}} · {{outcome}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#3274d9" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3274d9", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Guardrail checks",
      "description": "Every prompt and every answer is checked. A verdict of unsafe stops that step; refused means the guardrail could not answer.",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (side, verdict) (last_over_time(proven_guardrail_checks_total{instance=~\"$run\"}[$__range]))",
          "legendFormat": "{{side}} · {{verdict}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#8ab8ff" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#8ab8ff", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*unsafe.*|.*refused.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c4162a" } }]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Unsafe verdicts",
      "description": "Guardrail checks that returned unsafe.",
      "gridPos": { "x": 12, "y": 24, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time(proven_guardrail_unsafe_total{instance=~\"$run\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#37872d", "value": null }, { "color": "#c4162a", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Reviews seen",
      "description": "Reviews whose agents reported in this time range.",
      "gridPos": { "x": 16, "y": 24, "w": 4, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${ds_prom}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (instance) (last_over_time(proven_agent_state[$__range]))) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 11,
      "type": "table",
      "title": "The spans: each agent, and each reviewer's model calls",
      "description": "The trace of each review, from Tempo. One trace per review, one span per agent and per model call. Click a trace ID to open its waterfall: the two reviewers side by side.",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
          "queryType": "traceql",
          "query": "{ span.proven.agent != \"\" } | select(span.proven.agent, span.proven.reviewer, span.gen_ai.request.model)",
          "tableType": "spans",
          "limit": 100
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ]
}
