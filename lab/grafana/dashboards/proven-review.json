{
  "uid": "proven-review",
  "title": "Proven: one review, step by step",
  "description": "Pick a review at the top. See each agent in order, how long it took, and how the two reviewers judged each finding.",
  "tags": [
    "proven"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "style": "dark",
  "links": [
    {
      "type": "dashboards",
      "title": "Proven dashboards",
      "tags": [
        "proven"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2,
        "current": {}
      },
      {
        "name": "run",
        "label": "Review",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(proven_agent_state, instance)",
          "refId": "run"
        },
        "definition": "label_values(proven_agent_state, instance)",
        "refresh": 2,
        "sort": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Findings kept",
      "description": "Findings this review kept. None means a clean verdict.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_review_findings_total{instance=\"$run\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: findings kept",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0 findings kept: clean",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 46,
          "titleSize": 15
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Claims the Judge dropped",
      "description": "Claims dropped for being refuted, unproved, or already refuted in an earlier review.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_review_claims_dropped_total{instance=\"$run\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: claims dropped",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0 claims dropped",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 46,
          "titleSize": 15
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model calls that failed",
      "description": "Calls to a model that returned an error. In sample mode a call the recorded set has no answer for counts here too; the review goes on.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_model_calls_total{instance=\"$run\",outcome=\"error\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: calls failed",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "noValue": "0 calls failed",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 46,
          "titleSize": 15
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "The agents, in the order they ran, and how long each took",
      "description": "Each row is one agent of this review, from the trace. The bar is how long it ran. The two reviewers each run their own Planner and Skeptic.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 10
      },
      "transparent": false,
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.instance.id = \"$run\" && span.proven.agent != \"\" } | select(span.proven.agent, span.proven.reviewer, span.gen_ai.request.model)",
          "tableType": "spans",
          "limit": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No agent spans for this review yet.",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true,
              "spanID": true,
              "Trace ID": true,
              "Span ID": true,
              "traceService": true,
              "traceName": true,
              "nested": true
            },
            "renameByName": {
              "Start time": "Start time",
              "proven.agent": "Agent",
              "proven.reviewer": "Reviewer",
              "gen_ai.request.model": "Model",
              "Duration": "Duration"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "The Skeptic's verdicts, both reviewers side by side",
      "description": "How each reviewer's Skeptic judged each finding: refuted, upheld, or not attempted. Where the two columns differ, the reviewers disagree.",
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 10
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (proven_reviewer, verdict) (last_over_time(proven_reviewer_verdicts_total{instance=\"$run\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No verdict: this review kept no finding for the Skeptic to judge.",
          "custom": {
            "align": "left"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "proven_reviewer",
            "rowField": "verdict",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "verdict\\proven_reviewer": "Verdict"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Findings by level of proof",
      "description": "The strongest evidence each finding of this review carries.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 7
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (proven_proof_level) (last_over_time(proven_review_findings_total{instance=\"$run\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{proven_proof_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No finding in this review.",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Where the two reviewers disagree",
      "description": "Findings one reviewer named and the other did not, or that they judged differently.",
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 7
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (kind) (last_over_time(proven_reviewer_disagreements_total{instance=\"$run\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              }
            ]
          },
          "noValue": "The reviewers do not disagree on anything in this review.",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 8,
      "type": "text",
      "title": "Each finding, with its evidence",
      "description": "Where to read the evidence behind a finding.",
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 7
      },
      "options": {
        "mode": "markdown",
        "content": "The evidence of each finding (the query that found it, or the test that fails on the change and passes before it) is in the **Report** page of its pull request. Open the lab's start page and use the **Report** link in the table."
      }
    }
  ]
}
