{
  "uid": "proven-review",
  "title": "Proven: one review, step by step",
  "description": "Pick a review at the top. See each agent in order, how long it took, and how the two reviewers judged each finding.",
  "tags": [
    "proven"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "style": "light",
  "links": [
    {
      "type": "dashboards",
      "title": "Proven dashboards",
      "tags": [
        "proven"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2,
        "current": {}
      },
      {
        "name": "run",
        "label": "Pull request",
        "type": "custom",
        "includeAll": false,
        "multi": false,
        "query": "#1 Round the discount down to a whole cent : pr1-discount-clean,#2 Reword the draft note : pr2-unknown-author,#3 Apply a discount (it is taken off twice) : pr3-discount,#4 Add a padding helper from evil.example/drop : pr4-malicious-package,#5 Bump the widget library : pr5-osv-go-module,#6 Add a copyleft helper : pr6-spdx-licence,#7 Add a very young dependency : pr7-project-health",
        "options": [
          {
            "text": "#1 Round the discount down to a whole cent",
            "value": "pr1-discount-clean",
            "selected": false
          },
          {
            "text": "#2 Reword the draft note",
            "value": "pr2-unknown-author",
            "selected": false
          },
          {
            "text": "#3 Apply a discount (it is taken off twice)",
            "value": "pr3-discount",
            "selected": false
          },
          {
            "text": "#4 Add a padding helper from evil.example/drop",
            "value": "pr4-malicious-package",
            "selected": false
          },
          {
            "text": "#5 Bump the widget library",
            "value": "pr5-osv-go-module",
            "selected": false
          },
          {
            "text": "#6 Add a copyleft helper",
            "value": "pr6-spdx-licence",
            "selected": false
          },
          {
            "text": "#7 Add a very young dependency",
            "value": "pr7-project-health",
            "selected": true
          }
        ],
        "current": {
          "text": "#7 Add a very young dependency",
          "value": "pr7-project-health"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Findings this review kept",
      "description": "Findings this review kept. None means a clean verdict.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_review_findings_total{instance=\"$run\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: findings kept · blocked",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 findings kept · clean",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "1 finding kept · blocked",
                  "color": "red"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 48,
          "titleSize": 15
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Claims the Judge dropped",
      "description": "Claims dropped for being refuted, unproved, or already refuted in an earlier review.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_review_claims_dropped_total{instance=\"$run\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: dropped",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 · none dropped",
                  "color": "blue"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 40,
          "titleSize": 15
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model calls that failed",
      "description": "Calls to a model that returned an error. In sample mode a call the recorded set has no answer for counts here too; the review goes on.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_model_calls_total{instance=\"$run\",outcome=\"error\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: · check",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 · none failed",
                  "color": "green"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 40,
          "titleSize": 15
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "The agents, in order, and how long each took",
      "description": "Each row is one agent of this review, from the trace. The bar is how long it ran. The two reviewers each run their own Planner and Skeptic. In a sample-mode lab the agents answer from recorded answers and the Prover runs no test, so times of a few microseconds are the recorded answers, not real work. In a live lab they are real.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 15
      },
      "transparent": false,
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_tempo}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.instance.id = \"$run\" && span.proven.agent != \"\" } | select(span.proven.agent, span.proven.reviewer, span.gen_ai.request.model)",
          "tableType": "spans",
          "limit": 14
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Agent"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "planner": {
                        "text": "Planner"
                      },
                      "investigator": {
                        "text": "Investigator"
                      },
                      "prover": {
                        "text": "Prover"
                      },
                      "skeptic": {
                        "text": "Skeptic"
                      },
                      "fixer": {
                        "text": "Fixer"
                      },
                      "judge": {
                        "text": "Judge"
                      },
                      "writer": {
                        "text": "Writer"
                      },
                      "autofix": {
                        "text": "Autofix"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reviewer"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "default": {
                        "text": "default reviewer"
                      },
                      "special": {
                        "text": "second reviewer"
                      },
                      "shared": {
                        "text": "both reviewers"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Start time",
                "proven.agent",
                "proven.reviewer",
                "gen_ai.request.model",
                "Duration"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Start time": "Start time",
              "proven.agent": "Agent",
              "proven.reviewer": "Reviewer",
              "gen_ai.request.model": "Model",
              "Duration": "Duration"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Skeptic verdicts, by reviewer",
      "description": "How each reviewer's Skeptic judged each finding: refuted, upheld, or not attempted. Where the two differ, the reviewers disagree.",
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 8
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "label_join(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(sum by (proven_reviewer, verdict) (last_over_time(proven_reviewer_verdicts_total{instance=\"$run\"}[$__range])), \"proven_reviewer\", \"default reviewer\", \"proven_reviewer\", \"default\"), \"proven_reviewer\", \"second reviewer\", \"proven_reviewer\", \"special\"), \"proven_reviewer\", \"both reviewers\", \"proven_reviewer\", \"shared\"), \"verdict\", \"upheld\", \"verdict\", \"upheld\"), \"verdict\", \"refuted\", \"verdict\", \"refuted\"), \"verdict\", \"not attempted\", \"verdict\", \"not_attempted\"), \"who\", \" · \", \"proven_reviewer\", \"verdict\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{who}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No finding was kept, so the Skeptic had nothing to judge",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "displayName": "${__field.labels.who}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": false,
        "minVizHeight": 32,
        "maxVizHeight": 48,
        "minVizWidth": 8,
        "namePlacement": "top",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        },
        "text": {
          "titleSize": 16,
          "valueSize": 16
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Findings by level of proof",
      "description": "How well each kept finding is proved: the strongest evidence it carries.",
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 6
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(sum by (proven_proof_level) (last_over_time(proven_review_findings_total{instance=\"$run\"}[$__range])), \"proven_proof_level\", \"Proved by a tool\", \"proven_proof_level\", \"proved-by-tool\"), \"proven_proof_level\", \"Proved by a test\", \"proven_proof_level\", \"proved-by-test\"), \"proven_proof_level\", \"Proved by data\", \"proven_proof_level\", \"proved-by-data\"), \"proven_proof_level\", \"Agreed by two models, not proven\", \"proven_proof_level\", \"agreed-by-two-models-not-proven\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{proven_proof_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No finding kept: the reviews are still running, or every change was clean",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "displayName": "${__field.labels.proven_proof_level}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": false,
        "minVizHeight": 32,
        "maxVizHeight": 48,
        "minVizWidth": 8,
        "namePlacement": "top",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        },
        "text": {
          "titleSize": 16,
          "valueSize": 16
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Where the two reviewers disagree",
      "description": "Findings one reviewer named and the other did not, or that they judged differently.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "label_replace(label_replace(sum by (kind) (last_over_time(proven_reviewer_disagreements_total{instance=\"$run\"}[$__range])), \"kind\", \"Judged differently\", \"kind\", \"verdict\"), \"kind\", \"Named by one reviewer only\", \"kind\", \"one_reviewer\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "The two reviewers agree on this review",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              }
            ]
          },
          "displayName": "${__field.labels.kind}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": false,
        "minVizHeight": 32,
        "maxVizHeight": 48,
        "minVizWidth": 8,
        "namePlacement": "top",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        },
        "text": {
          "titleSize": 16,
          "valueSize": 16
        }
      }
    },
    {
      "id": 8,
      "type": "text",
      "title": "Each finding, with its evidence",
      "description": "Where to read the evidence behind a finding.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "The evidence of each finding (the query that found it, or the test that fails on the change and passes before it) is in the **Report** page of its pull request. Open the lab's start page and use the **Report** link in the table."
      }
    }
  ]
}
