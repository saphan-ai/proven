{
  "uid": "proven-models",
  "title": "Proven: which models answered, and what the guardrail checked",
  "description": "Calls to models by agent and reviewer, which model answered, what the guardrail checked, and what Proven refused to keep.",
  "tags": [
    "proven"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "style": "dark",
  "links": [
    {
      "type": "dashboards",
      "title": "Proven dashboards",
      "tags": [
        "proven"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Model calls",
      "description": "Calls to a model across all reviews.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_model_calls_total[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: model calls",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0 model calls",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 46,
          "titleSize": 15
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Model calls that returned an error",
      "description": "A model call that returned an error. In sample mode a call the recorded answers have no answer for is counted here (generator: no recorded response); the review goes on without it. In a live lab an error is a failed call to the model.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_model_calls_total{outcome=\"error\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: calls with an error",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "noValue": "0 calls with an error",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 46,
          "titleSize": 15
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Guardrail checks that said unsafe",
      "description": "Model answers or prompts the guardrail judged unsafe. None is good.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_guardrail_unsafe_total[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: unsafe",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0 unsafe",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 46,
          "titleSize": 15
        }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Calls, by agent and reviewer",
      "description": "Which agent made the calls, and for which reviewer. Planner and Skeptic run once per reviewer.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (proven_agent, proven_reviewer) (last_over_time(proven_model_calls_total[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{proven_agent}} · {{proven_reviewer}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "No model call yet.",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Calls, by the model asked and the model that answered",
      "description": "The model a call asked for, and the model the provider says answered it. When a fallback answers, the two differ (NVIDIA first, then the fallback model). Sample mode names no answering model.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (gen_ai_request_model, gen_ai_response_model) (last_over_time(gen_ai_client_operation_duration_seconds_count[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{gen_ai_request_model}} → {{gen_ai_response_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "No model call yet.",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Guardrail checks, by side and verdict",
      "description": "What the guardrail was asked to check (the prompt or the answer) and what it said.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (side, verdict) (last_over_time(proven_guardrail_checks_total[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{side}} · {{verdict}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No guardrail check yet.",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "What Proven refused to keep, by reason",
      "description": "Claims the Judge dropped: refuted by the Skeptic, no evidence, or already refuted in an earlier review (suppressed).",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (reason) (last_over_time(proven_review_claims_dropped_total[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              }
            ]
          },
          "noValue": "Nothing was dropped yet.",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Model latency, mean per call (sample mode: recorded answers, not real model latency)",
      "description": "Mean time of a model call. In sample mode the answers are recorded, so this is not a measure of any model; in a live lab it is the real latency of each agent's calls.",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (proven_agent, proven_reviewer) (last_over_time(gen_ai_client_operation_duration_seconds_sum[$__range])) / sum by (proven_agent, proven_reviewer) (last_over_time(gen_ai_client_operation_duration_seconds_count[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{proven_agent}} · {{proven_reviewer}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "No model call yet.",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        }
      }
    }
  ]
}
