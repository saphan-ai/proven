{
  "uid": "proven-overview",
  "title": "Proven: every pull request at a glance",
  "description": "Every pull request the lab reviewed (its latest review), whether Proven blocked the broken ones, and whether it raised a false alarm on the clean ones.",
  "tags": [
    "proven"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "style": "light",
  "links": [
    {
      "type": "dashboards",
      "title": "Proven dashboards",
      "tags": [
        "proven"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pull requests blocked",
      "description": "Pull requests on which Proven kept at least one finding, out of the 7 demo pull requests (5 broken, 2 clean). Every kept finding carries evidence.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "count(sum by (instance) (last_over_time(proven_review_findings_total{instance=~\"pr[0-9]+-.+\"}[$__range])) > 0) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: of 7 pull requests blocked",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 of 7 pull requests blocked",
                  "color": "blue"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 48,
          "titleSize": 15
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reviews finished",
      "description": "Pull requests whose review is done: its last agent, the Writer, finished.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "count(max by (instance) (last_over_time(proven_agent_state{proven_agent=\"writer\",instance=~\"pr[0-9]+-.+\"}[$__range])) == 2) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: of 7 finished",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 7
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 of 7 finished",
                  "color": "blue"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 40,
          "titleSize": 15
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "False alarms on the clean changes",
      "description": "Findings Proven kept on the 2 clean demo pull requests. None is good: a clean change must get a clean verdict.",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_review_findings_total{instance=~\"pr[0-9]+-(discount-clean|unknown-author)\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: · bad",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 · none, good",
                  "color": "green"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 40,
          "titleSize": 15
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Agents that failed",
      "description": "Agent stages that ended failed in the latest review of any pull request. None is good: a failed agent means part of the review did not run.",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "count(last_over_time(proven_agent_state{instance=~\"pr[0-9]+-.+\"}[$__range]) == 3) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: · bad",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 · none, good",
                  "color": "green"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 40,
          "titleSize": 15
        }
      }
    },
    {
      "id": 7,
      "type": "text",
      "title": "What the numbers count",
      "description": "Every number on this page counts the same thing.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Each number counts **pull requests**, using the **latest review** of each. 7 demo pull requests: 5 broken, 2 clean. A review that has not finished is counted as it stands."
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Every pull request: how its review ended",
      "description": "One row per demo pull request, its latest review. Verdict: clean when no finding was kept, blocked when one was. Findings and Claims dropped count that one review.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 10
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (pr, change) (label_replace(label_replace(last_over_time(proven_agent_state{proven_agent=\"writer\",instance=~\"pr[0-9]+-.+\"}[$__range]), \"pr\", \"$1\", \"instance\", \"pr([0-9]+)-.*\"), \"change\", \"$1\", \"instance\", \"pr[0-9]+-(.*)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (pr, change) (label_replace(label_replace(sum by (instance) (last_over_time(proven_review_findings_total{instance=~\"pr[0-9]+-.+\"}[$__range])), \"pr\", \"$1\", \"instance\", \"pr([0-9]+)-.*\"), \"change\", \"$1\", \"instance\", \"pr[0-9]+-(.*)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "max by (pr, change) (label_replace(label_replace(sum by (instance) (last_over_time(proven_review_claims_dropped_total{instance=~\"pr[0-9]+-.+\"}[$__range])), \"pr\", \"$1\", \"instance\", \"pr([0-9]+)-.*\"), \"change\", \"$1\", \"instance\", \"pr[0-9]+-(.*)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "clamp_max(max by (pr, change) (label_replace(label_replace(sum by (instance) (last_over_time(proven_review_findings_total{instance=~\"pr[0-9]+-.+\"}[$__range])), \"pr\", \"$1\", \"instance\", \"pr([0-9]+)-.*\"), \"change\", \"$1\", \"instance\", \"pr[0-9]+-(.*)\")), 1)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Verdict"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "clean",
                        "color": "green"
                      },
                      "1": {
                        "text": "blocked",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "waiting",
                        "color": "yellow"
                      },
                      "1": {
                        "text": "working",
                        "color": "blue"
                      },
                      "2": {
                        "text": "finished",
                        "color": "green"
                      },
                      "3": {
                        "text": "failed",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pull request"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Pull request",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "pr",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "pr": 0,
              "change": 1,
              "Value #D": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #A": 5
            },
            "renameByName": {
              "pr": "Pull request",
              "change": "Change",
              "Value #D": "Verdict",
              "Value #B": "Findings",
              "Value #C": "Claims dropped",
              "Value #A": "State"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Findings by level of proof",
      "description": "How well each kept finding is proved: the strongest evidence it carries.",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 10
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (proven_proof_level) (last_over_time(proven_review_findings_total{instance=~\"pr[0-9]+-.+\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{proven_proof_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No finding kept: the reviews are still running, or every change was clean",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 28,
        "minVizWidth": 8,
        "namePlacement": "top",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        },
        "text": {
          "titleSize": 16,
          "valueSize": 20
        }
      }
    }
  ]
}
