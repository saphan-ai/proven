{
  "uid": "proven-evidence",
  "title": "Proven: the evidence behind each finding",
  "description": "Where findings get their proof. What Proven does not yet report as a number is named in the two grey panels.",
  "tags": [
    "proven"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "style": "dark",
  "links": [
    {
      "type": "dashboards",
      "title": "Proven dashboards",
      "tags": [
        "proven"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 2,
        "current": {}
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Zetaris queries: not measured yet",
      "description": "What would be shown here, and the numbers that are missing.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "**Not emitted by Proven yet.** Proven asks Zetaris for each advisory check, but does not yet count it. Missing, so nothing is drawn here:\n\n- queries per table (OSV, KEV, EPSS)\n- rows returned\n- query duration\n- queries Zetaris refused\n\nThe proof level of each finding, which comes from these queries, is shown below."
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "Prover runs: not measured yet",
      "description": "What would be shown here, and the numbers that are missing.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "**Not emitted by Proven yet.** The Prover runs a test on the base and on the change, with the network off. Missing, so nothing is drawn here:\n\n- runs, with the outcome on the base and on the change\n- run duration\n- runs that had the network off\n\nHow long the Prover and the Investigator ran is in the table below."
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Evidence agents that failed",
      "description": "Investigator or Prover stages that ended failed. None is good: a failed one means evidence was not gathered.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "count(last_over_time(proven_agent_state{proven_agent=~\"investigator|prover\"}[$__range]) == 3) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: · bad",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 · none, good",
                  "color": "green"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 40,
          "titleSize": 15
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Claims dropped for no evidence",
      "description": "Claims the Judge dropped because no query or test supported them. This is Proven refusing to guess.",
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(last_over_time(proven_review_claims_dropped_total{reason=\"no_evidence\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: dropped",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0 · none dropped",
                  "color": "blue"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 40,
          "titleSize": 15
        }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Findings by level of proof",
      "description": "How well each kept finding is proved: the strongest evidence it carries.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (proven_proof_level) (last_over_time(proven_review_findings_total[$__range])) or on() label_replace(vector(0), \"proven_proof_level\", \"No finding kept: the reviews are still running, or every change was clean\", \"\", \"\")",
          "instant": true,
          "range": false,
          "legendFormat": "{{proven_proof_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "displayName": "${__field.labels.proven_proof_level}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "top",
        "sizing": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Investigator and Prover runs (the latest 20)",
      "description": "Each row is one run of the Investigator (turns a risk into a query) or the Prover (asks for a test). The bar is how long it ran.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 19
      },
      "transparent": false,
      "datasource": {
        "type": "tempo",
        "uid": "${ds_tempo}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_tempo}"
          },
          "queryType": "traceql",
          "query": "{ span.proven.agent = \"investigator\" || span.proven.agent = \"prover\" } | select(span.proven.agent, span.proven.reviewer)",
          "tableType": "spans",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true,
              "spanID": true,
              "Trace ID": true,
              "Span ID": true,
              "traceService": true,
              "traceName": true,
              "nested": true
            },
            "renameByName": {
              "Start time": "Start time",
              "proven.agent": "Agent",
              "proven.reviewer": "Reviewer",
              "Duration": "Duration"
            }
          }
        }
      ]
    }
  ]
}
