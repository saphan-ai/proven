# Settings for `make livecheck` and a live review in the lab. Copy this file to lab/.env and fill it in.
# lab/.env is not committed (.gitignore). Sample mode and `make sample` do not read it.
# Do not put quotes around a value.
#
# Secrets are EMPTY here, never a placeholder: an empty key is a service the review names as down, while a
# placeholder would be sent as a key. Settings that are not secret carry their default, so you see what runs.
# docs/CONFIGURATION.md is the full list; this file follows it.

# --- Live mode with one NVIDIA key (ADR-0031). One key from build.nvidia.com serves both lines. ---
# The generator: `nightshift` (Meterless Nightshift, the default) or `nvidia` (NVIDIA's hosted API). Coming: not on main yet.
PROVEN_GENERATOR_MODE=nightshift
# The generator's key in `nvidia` mode. Secret. Coming with the mode above.
PROVEN_GENERATOR_KEY=
# The guardrail: `server` (your own model server), `nvidia` (NVIDIA's hosted API) or `off`.
PROVEN_GUARDRAIL_MODE=server
# The guardrail's key, from build.nvidia.com in `nvidia` mode. Secret. Empty is not off: every model call is refused.
PROVEN_GUARDRAIL_KEY=

# --- Meterless Nightshift, the generator's default provider (ADR-0019). ---
# Nightshift's address.
PROVEN_GENERATOR_BASE_URL=http://127.0.0.1:8088
# The runtime token Nightshift gives you. Secret. Empty: Nightshift is down and the review names it.
METERLESS_RUNTIME_TOKEN=

# --- A second reviewer you bring (ADR-0037): any OpenAI-compatible API, e.g. xAI, OpenAI, Anthropic. Coming. ---
# The API's address, e.g. https://api.x.ai/v1.
PROVEN_SECOND_REVIEWER_BASE_URL=
# Its key, from that provider's console. Secret.
PROVEN_SECOND_REVIEWER_KEY=
# The model to ask, as that provider names it.
PROVEN_SECOND_REVIEWER_MODEL=

# --- Zetaris, where the evidence is queried (ADR-0023). From your Zetaris organisation. ---
# Zetaris's REST address: an absolute http or https URL.
ZETARIS_REST_URL=
# Proven's Zetaris key. Secret. Empty: Zetaris is down and the review names it.
ZETARIS_API_KEY=
# The organisation id sent with each query.
ZETARIS_ORG_ID=
