# Settings for going live (docs/LAB.md, "Go live") and for `make livecheck`. Copy this file to lab/.env and fill in
# what you have. lab/.env is not committed (.gitignore). Sample mode and `make sample` do not read it.
# Do not put quotes around a value. One line per setting: NAME=value.
#
# `make up` reads this file and stores each NON-EMPTY setting below as an Actions secret of the demo repository
# (never in a file, an image or a log). An empty setting is not stored, and a secret you emptied is removed. With no
# key at all the lab reviews in sample mode. Then open a NEW pull request: a review that already ran is not redone.
#
# Secrets are EMPTY here, never a placeholder: an empty key is a service the review names as down, while a
# placeholder would be sent as a key. docs/CONFIGURATION.md is the full list of what each setting means.

# --- Path A: one NVIDIA key (ADR-0031). Enough on its own. ---
# The key, from https://build.nvidia.com (sign in, open any model, Get API Key). Secret.
# The lab uses it for the generator and, unless you set a guardrail key below, for the guardrail too.
PROVEN_GENERATOR_KEY=
# Leave these three empty: the lab picks `nvidia` mode when only a key is set. Set them to override.
PROVEN_GENERATOR_MODE=
PROVEN_NVIDIA_BASE_URL=
PROVEN_GUARDRAIL_MODE=
# A guardrail key of its own, if you want one different from the generator's. Secret.
PROVEN_GUARDRAIL_KEY=

# --- Path B: our services through the judges' gateway. Sent to you privately. ---
# The gateway's address (a host name; it is public) and YOUR token (secret, yours alone, it expires when judging ends).
JUDGES_GATEWAY_URL=
JUDGES_GATEWAY_TOKEN=

# --- Path C: your own Zetaris and Nightshift. ---
# Zetaris on this machine: the docker-compose.yml of the bundle you unpacked from your own Zetaris account.
# `make up ZETARIS=local` runs it with the lab's override (127.0.0.1 only). You must be signed in to the sponsor's registry.
ZETARIS_COMPOSE_FILE=
# Proven's own Zetaris user (a non-admin, made in the console), its API key (secret) and the numeric organisation id.
ZETARIS_PROVEN_USER=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# Only to register the evidence definitions, once: the Zetaris ADMINISTRATOR's key (secret). It is used by
# `make up ZETARIS=local` for that and is NOT stored as a secret of the repository.
ZETARIS_ADMIN_API_KEY=
# Zetaris's REST address when it is not the one the lab started (empty: the lab's own, when ZETARIS=local).
ZETARIS_REST_URL=
# Nightshift: its address (`make nightshift` prints it) and its runtime token (secret, shown in its own window).
PROVEN_GENERATOR_BASE_URL=
METERLESS_RUNTIME_TOKEN=

# --- A second reviewer you bring (ADR-0037): any OpenAI-compatible API, e.g. xAI, OpenAI, Anthropic. Coming. ---
# Read by `make livecheck` only; the lab does not store these.
PROVEN_SECOND_REVIEWER_BASE_URL=
PROVEN_SECOND_REVIEWER_KEY=
PROVEN_SECOND_REVIEWER_MODEL=

# --- The start-up flow (make up). Every question it asks on a terminal can be answered here instead, so a script never waits. ---
# Empty means: ask on a terminal; with no terminal, sample mode and no question. docs/LAB.md, "The start-up flow".
# sample | live
PROVEN_LAB_MODE=
# yes | no (live only): are you a judge of the Open Agent Hackathon
PROVEN_LAB_JUDGE=
# ours | own (a judge, live): our services through the judges' gateway, or your own
PROVEN_LAB_BACKEND=
# access | token (ours; empty means access): the Cloudflare Access e-mail sign-in, or the token we sent you
PROVEN_LAB_GATEWAY_AUTH=
# yes | no (own): run the automated setup (make up ZETARIS=local, then make nightshift)
PROVEN_LAB_OWN_SETUP=
# yes | no (own): use the Zetaris (localhost:8888) and Nightshift (127.0.0.1:8088) that already answer on this machine
PROVEN_LAB_USE_DETECTED=
# The Meterless features. Each is Proven's own setting, passed through as you give it: leave it empty and Proven's own
# default stands. On a terminal, make up asks about each one that is empty; a script or CI that sets both is never asked.
# on | off: Markovian, bounded steps for a large change (Proven's PROVEN_MARKOVIAN; used by live reviews)
PROVEN_MARKOVIAN=
# on | off: Scout Intent, a plan for each review (Proven's scout_intent key in proven.yaml; the lab writes it for the review)
PROVEN_LAB_SCOUT_INTENT=
# H-MEM (memory of refuted findings) and World Model (claims, evidence and verdicts as a graph) have no switch in Proven yet.

# --- The names of the organisers' Participant Setup Guide, read as they are (the Proven name wins when both are set). ---
# METERLESS_BASE_URL is PROVEN_GENERATOR_BASE_URL and METERLESS_MODEL is PROVEN_GENERATOR_MODEL. METERLESS_RUNTIME_TOKEN,
# ZETARIS_REST_URL, ZETARIS_ORG_ID and ZETARIS_API_KEY are the names used above.
METERLESS_BASE_URL=
METERLESS_MODEL=
PROVEN_GENERATOR_MODEL=
# Path B by Cloudflare Access: the flow signs you in with cloudflared and stores the token itself. Leave this empty.
JUDGES_GATEWAY_ACCESS_TOKEN=
